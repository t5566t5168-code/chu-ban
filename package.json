{
  "name": "quiet-reader",
  "productName": "Quiet Reader",
  "version": "1.0.0",
  "description": "留白 · 離線 UTF-8 TXT 閱讀器",
  "author": "Quiet Reader",
  "private": true,
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "package": "electron-forge package --platform=win32 --arch=x64",
    "make": "electron-forge make --platform=win32 --arch=x64"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "electron": "42.11.15",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
